<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 TargetTapper"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1. Accesibilidad -->
        <TextView
            android:id="@+id/tvAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar servicio de accesibilidad" />

        <Button
            android:id="@+id/btnAppInfo"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Aparece bloqueado? Abrir info de la app" />

        <!-- 2. Notificaciones -->
        <TextView
            android:id="@+id/tvNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conceder notificaciones" />

        <!-- 3. App objetivo -->
        <TextView
            android:id="@+id/tvApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionar app a vigilar" />

        <!-- 4. Iniciar -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="Iniciar"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Al pulsar «Iniciar», Android pedirá permiso para capturar la pantalla (último permiso). Después se abrirá la app seleccionada y TargetTapper pulsará cada diana roja y blanca que detecte, mostrando un marcador cian en el punto exacto del toque."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
